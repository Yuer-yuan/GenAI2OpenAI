# 从浏览器 GenAI 的 chat 请求头复制 x-access-token，只粘贴值，不加 Bearer。
GENAI_TOKEN=

# 本机访问。5000 端口通常被 macOS 占用，因此使用 8000。
GENAI_HOST=127.0.0.1
GENAI_PORT=8000
GENAI_LOG_LEVEL=INFO
# 本地开发自动重载 Python 代码和 .env；关闭用 0 或启动参数 --no-reload。
GENAI_RELOAD=1

# 可选：图片上传请求头中的 token，仅使用图片功能时需要。
GENAI_UPLOAD_TOKEN=

# Claude Code 辅助请求使用 claude-* 模型名时的实际模型。
GENAI_CLAUDE_HELPER_MODEL=deepseek

# 工具历史：默认 tagged 保留调用 ID、参数对象和执行状态。
# legacy 为旧版回放；native 仅用于诊断，当前学校接口的多轮实测较差。
GENAI_TOOL_HISTORY=tagged

# auto：非 GPT 使用原生图文；GPT 保留旧版单图上传兼容。
# native：强制原生多模态；legacy：旧 GPT 上传模式。
GENAI_IMAGE_TRANSPORT=auto
